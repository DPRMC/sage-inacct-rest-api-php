<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <php>
        <env name="SAGE_INTEGRATION_CLIENT_ID" value="" force="true"/>
        <env name="SAGE_INTEGRATION_CLIENT_SECRET" value="" force="true"/>
        <env name="SAGE_INTEGRATION_USERNAME" value="" force="true"/>
        <env name="SAGE_INTEGRATION_READ_ONLY" value="1" force="true"/>
        <env name="SAGE_INTEGRATION_REQUIRE_CREDENTIALS" value="0" force="true"/>
        <env name="SAGE_INTEGRATION_BASE_URL" value="https://api.intacct.com/ia/api/v1" force="true"/>
        <env name="SAGE_INTEGRATION_OBJECT" value="accounts-payable/vendor" force="true"/>
        <env name="SAGE_INTEGRATION_SCOPE" value="" force="true"/>
    </php>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
